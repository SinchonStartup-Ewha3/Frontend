VITE_API_URL=https://api.weether.kr
VITE_KAKAO_JS_KEY=
VITE_KAKAO_REST_KEY=
VITE_KAKAO_REDIRECT_URI=https://api.weether.kr/auth/kakao
VITE_VAPID_PUBLIC_KEY=
VITE_USE_MOCK=false

# Paddle sandbox client configuration. Never put server API keys or webhook secrets here.
VITE_PADDLE_CLIENT_TOKEN=
VITE_PADDLE_ENVIRONMENT=sandbox
VITE_PADDLE_PRICE_PREMIUM=
VITE_PADDLE_PRICE_FORTUNE=

# 카카오키랑 vapid key는 추후에 기능 구현할 때 제대로 채워넣을게요 @.@ 
